rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user has the 'admin' role in their user profile
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if the user is the owner of the document (by ID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Collections ---

    // 1. Users Collection
    // - Admins can read/write everything.
    // - Users can read/write ONLY their own document.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 2. Public Data (Schedules, Routes, Stops, Tariffs, Notifications)
    // - Public: READ only.
    // - Admin: WRITE (Create, Update, Delete).
    
    match /rutas/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /paradas/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /horarios/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tarifas/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /metadata/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 3. Contact Messages / Inquiries
    // - Any Authenticated user can CREATE a message.
    // - Admins can READ/UPDATE (to answer).
    // - Users can READ their own messages (checked by email as per app logic).
    match /contacts/{contactId} {
      allow create: if isAuthenticated() && 
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
       // Allow update only for Admins (e.g. marking as answered)
      allow update, delete: if isAdmin();
    }
    
    // 4. Admin Only Management (Units, Drivers, etc.)
    match /unidades/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /choferes/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
